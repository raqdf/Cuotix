# Copia este archivo como .env y completa los valores.
# Pega el JSON completo de la cuenta de servicio en una sola linea.
# Escapa los saltos de linea de private_key como \n dentro de la cadena JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=

# API key web de Firebase usada por el inicio de sesion.
FIREBASE_WEB_API_KEY=

# Credenciales temporales de desarrollo; solo se aceptan en localhost con debug activo.
# Usa una contraseña nueva de al menos 12 caracteres y no subas el archivo .env al repositorio.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# Clave secreta de Flask; usa un valor aleatorio largo.
FLASK_SECRET_KEY=

# Alternativa a FIREBASE_SERVICE_ACCOUNT_JSON: ruta a un JSON montado como secreto.
# Si se omite, se conserva la ruta antigua serviceAccountKey.json.
# FIREBASE_CREDENTIALS_PATH=
